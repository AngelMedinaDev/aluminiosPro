---
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title || "Aluminios Pro | Cotizador"}</title>
        <!-- Inyectando Tailwind directo (Solución rápida y efectiva) -->
        <script src="https://cdn.tailwindcss.com"></script>
    </head>
    <body class="m-0 w-full min-h-screen bg-slate-100 font-sans antialiased text-slate-800">
        <slot />
    </body>
</html>

<style is:global>
    /* Aquí puedes meter estilos globales si ocupas después, por ahora lo dejamos limpio */
</style>