---
// src/pages/cotizacion.astro
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const id = Astro.url.searchParams.get('id');

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

let cot = null;
if (id) {
    const { data } = await supabase
        .from('cotizaciones')
        .select('*')
        .eq('id', Number(id))
        .maybeSingle();
    cot = data;
} else {
    // Si entran sin ?id=, mostramos la última cotización para que siempre puedas probarla
    const { data } = await supabase
        .from('cotizaciones')
        .select('*')
        .order('id', { ascending: false })
        .limit(1)
        .maybeSingle();
    cot = data;
}

if (!cot) {
    return new Response('Aún no hay cotizaciones registradas para generar PDF.', { status: 404 });
}

let empresa = {
    nombre_taller: 'Aluminios Pro',
    telefono: '81 0000 0000',
    logo_url: ''
};

if (cot.empresa_id) {
    const { data: empData } = await supabase
        .from('empresas')
        .select('*')
        .eq('id', cot.empresa_id)
        .maybeSingle();
    if (empData) empresa = empData;
}

const det = cot.detalles_json || {};
const nombreTipo = (t: string) => {
    if (t === 'v2') return 'Ventana Corrediza Línea 2" en Aluminio y Cristal 6mm';
    if (t === 'pta3') return 'Puerta Residencial Línea 3" en Aluminio y Cristal';
    return t || 'Cancelería de Aluminio a Medida';
};

const partidas = Array.isArray(det.partidas) && det.partidas.length > 0
    ? det.partidas
    : [{
        tipo: det.tipo || 'v2',
        cantidad: det.cantidad || 1,
        largo: det.largo || 0,
        alto: det.alto || 0,
        subtotal: cot.total || 0
    }];

const fechaEmision = new Date(cot.created_at);
const fechaVencimiento = new Date(fechaEmision.getTime() + 7 * 24 * 60 * 60 * 1000); // 7 días de vigencia estricta

const fmtFecha = (d: Date) => d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
const fmtMXN = (n: any) => '$' + (Number(n) || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const totalFinal = Number(cot.total) || 0;
const anticipoRequerido = totalFinal * 0.60; // 60% blindaje de materia prima
const saldoContraEntrega = totalFinal * 0.40;
---

<Layout title={`Cotización #${String(cot.id).padStart(4, '0')} - ${empresa.nombre_taller}`}>
    <div class="min-h-screen bg-slate-300 py-6 px-3 sm:px-6 print:bg-white print:p-0 font-sans">
        <!-- Barra superior flotante (No sale en el PDF impreso) -->
        <div class="max-w-4xl mx-auto mb-4 flex flex-wrap justify-between items-center gap-3 bg-slate-900 text-white p-4 rounded-xl shadow-lg print:hidden">
            <div>
                <p class="font-bold text-sm m-0">Vista Previa de Cotización Formal Protegida</p>
                <p class="text-xs text-slate-400 m-0">Al darle clic en Descargar PDF, elige "Guardar como PDF" en el destino.</p>
            </div>
            <div class="flex gap-2">
                <a href="/seguimiento" class="bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold px-4 py-2.5 rounded-lg no-underline">
                    ← Volver al CRM
                </a>
                <button
                    onclick="window.print()"
                    class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-5 py-2.5 rounded-lg text-xs cursor-pointer border-0 shadow-lg"
                >
                    📄 Descargar / Imprimir PDF
                </button>
            </div>
        </div>

        <!-- HOJA MEMBRETADA TAMAÑO CARTA -->
        <div class="max-w-4xl mx-auto bg-white p-6 sm:p-10 rounded-xl shadow-2xl print:shadow-none print:rounded-none text-slate-800 border border-slate-200 print:border-0">
            
            <!-- 1. Encabezado Membretado y Vigencia -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b-4 border-slate-900 pb-5 gap-4">
                <div class="flex items-center gap-4">
                    {empresa.logo_url ? (
                        <img src={empresa.logo_url} alt="Logo" class="h-16 w-auto max-w-[140px] object-contain" />
                    ) : (
                        <div class="w-16 h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-2xl">
                            {empresa.nombre_taller.substring(0, 2).toUpperCase()}
                        </div>
                    )}
                    <div>
                        <h1 class="text-2xl font-black text-slate-900 m-0 uppercase tracking-tight">{empresa.nombre_taller}</h1>
                        <p class="text-xs font-semibold text-slate-500 m-0">Fabricación e Instalación de Cancelería de Aluminio y Vidrio</p>
                        {empresa.telefono && <p class="text-xs font-bold text-blue-700 m-0 mt-1">Atención y WhatsApp: +52 {empresa.telefono}</p>}
                    </div>
                </div>

                <div class="w-full sm:w-auto grid grid-cols-2 sm:block gap-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-left sm:text-right">
                    <div>
                        <p class="text-[10px] font-bold uppercase text-slate-400 m-0">Folio de Control</p>
                        <p class="text-xl font-black text-slate-900 m-0">COT-{String(cot.id).padStart(4, '0')}</p>
                    </div>
                    <div class="sm:mt-1.5">
                        <p class="text-[10px] font-bold uppercase text-slate-400 m-0">Emisión: <span class="text-slate-700">{fmtFecha(fechaEmision)}</span></p>
                        <p class="text-[11px] font-black uppercase text-red-600 m-0 mt-0.5">Vence: {fmtFecha(fechaVencimiento)} (7 días)</p>
                    </div>
                </div>
            </div>

            <!-- 2. Datos del Cliente y Obra -->
            <div class="my-5 grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs">
                <div>
                    <span class="font-bold uppercase text-slate-400 block text-[10px]">Cliente / Atención:</span>
                    <span class="font-black text-slate-900 text-sm">{cot.cliente_nombre}</span>
                </div>
                <div>
                    <span class="font-bold uppercase text-slate-400 block text-[10px]">Teléfono / WhatsApp:</span>
                    <span class="font-semibold text-slate-800 text-sm">+52 {cot.cliente_telefono || 'S/N'}</span>
                </div>
                <div>
                    <span class="font-bold uppercase text-slate-400 block text-[10px]">Tipo de Cotización:</span>
                    <span class="font-bold text-amber-700">Preliminar sobre medidas proporcionadas</span>
                </div>
            </div>

            <!-- 3. Tabla Técnica de Partidas -->
            <table class="w-full text-left border-collapse my-5 text-xs">
                <thead>
                    <tr class="bg-slate-900 text-white uppercase text-[11px] tracking-wider">
                        <th class="p-3 rounded-tl-lg text-center w-14">Part.</th>
                        <th class="p-3 text-center w-16">Cant.</th>
                        <th class="p-3">Especificación Técnica del Trabajo</th>
                        <th class="p-3 text-center">Dimensiones (Largo x Alto)</th>
                        <th class="p-3 text-right">P. Unitario</th>
                        <th class="p-3 text-right rounded-tr-lg">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 border-b border-slate-300">
                    {partidas.map((p: any, idx: number) => {
                        const cant = Number(p.cantidad) || 1;
                        const sub = Number(p.subtotal) || 0;
                        const unit = sub / cant;
                        return (
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 text-center font-bold text-slate-400">#{idx + 1}</td>
                                <td class="p-3 text-center font-black text-slate-900">{cant} pza</td>
                                <td class="p-3">
                                    <p class="font-bold text-slate-900 m-0">{nombreTipo(p.tipo)}</p>
                                    <p class="text-[11px] text-slate-500 m-0">Incluye perfiles de aluminio, herrajes de línea, felpa, vinil y sellado perimetral.</p>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-slate-800">{Number(p.largo).toFixed(2)}m × {Number(p.alto).toFixed(2)}m</td>
                                <td class="p-3 text-right text-slate-700">{fmtMXN(unit)}</td>
                                <td class="p-3 text-right font-black text-slate-900">{fmtMXN(sub)}</td>
                            </tr>
                        );
                    })}
                </tbody>
            </table>

            <!-- 4. Desglose Financiero y Plan de Pagos (Blindaje de Flujo de Efectivo) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-6 items-start">
                <div class="bg-blue-50/70 border border-blue-200 rounded-xl p-4 text-xs space-y-1.5">
                    <p class="font-black text-blue-950 uppercase m-0 text-[11px]">Esquema de Pagos para Orden de Producción:</p>
                    <div class="flex justify-between pt-1">
                        <span class="text-slate-600 font-semibold">1. Anticipo para compra de material (60%):</span>
                        <span class="font-black text-blue-800">{fmtMXN(anticipoRequerido)}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-600 font-semibold">2. Liquidación contra entrega / instalación (40%):</span>
                        <span class="font-bold text-slate-800">{fmtMXN(saldoContraEntrega)}</span>
                    </div>
                    <p class="text-[10px] text-slate-500 m-0 pt-1">* Precios expresados en Moneda Nacional (MXN). En caso de requerir factura fiscal se agregará el 16% de IVA.</p>
                </div>

                <div class="bg-slate-900 text-white p-5 rounded-xl space-y-2">
                    <div class="flex justify-between items-center text-xs text-slate-400">
                        <span>Total de Piezas:</span>
                        <span class="font-bold text-white">{partidas.reduce((acc: number, p: any) => acc + (Number(p.cantidad) || 1), 0)} pieza(s)</span>
                    </div>
                    <div class="flex justify-between items-center border-t border-slate-700 pt-2">
                        <span class="text-xs uppercase font-bold text-slate-300">Inversión Total:</span>
                        <span class="text-2xl font-black text-green-400">{fmtMXN(totalFinal)}</span>
                    </div>
                </div>
            </div>

            <!-- 5. Cláusulas de Control y Protección contra Pérdidas -->
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-[10.5px] leading-relaxed text-slate-600 space-y-1">
                <p class="font-black text-slate-800 uppercase text-[11px] m-0 mb-1">Términos de Control Técnico y Protección de Obra (Importante):</p>
                <p class="m-0"><strong>1. VIGENCIA DEL PRESUPUESTO:</strong> Debido a la fluctuación constante en el costo del aluminio y cristal flotado, esta cotización tiene una validez estricta de <strong>7 días naturales</strong> (hasta el {fmtFecha(fechaVencimiento)}). Pasada esta fecha, los precios están sujetos a recálculo sin previo aviso.</p>
                <p class="m-0"><strong>2. RECTIFICACIÓN DE MEDIDAS Y TOLERANCIAS:</strong> Este presupuesto está calculado con medidas preliminares. Una vez cubierto el anticipo, se realizará el levantamiento físico definitivo en obra. Si los vanos reales presentan variaciones mayores a <strong>±2 cm</strong> respecto a las medidas aquí cotizadas, se ajustará la diferencia proporcional de material antes de cortar.</p>
                <p class="m-0"><strong>3. CONDICIONES DEL VANO Y ALBAÑILERÍA:</strong> El precio considera vanos a plomo, nivelados y terminados. <strong>No incluye trabajos de albañilería</strong>, resanes de mezcla, pintura, demoliciones, retiro de herrería existente ni maniobras de elevación por fachada en pisos superiores salvo que se especifique por escrito.</p>
                <p class="m-0"><strong>4. CORTE A MEDIDA Y CANCELACIONES:</strong> Todo trabajo de cancelería se fabrica a la medida exacta del cliente. Una vez autorizado el corte de perfiles o vidrio y recibido el anticipo, <strong>no existen devoluciones de anticipo</strong> por cancelaciones o cambios de diseño ajenos al taller, ya que el material cortado constituye merma irrecuperable.</p>
                <p class="m-0"><strong>5. GARANTÍA:</strong> Se otorga garantía sobre defectos de fabricación, sellado perimetral y funcionamiento de rodamientos/herrajes. IMPORTANTE: Conforme a la norma de la industria, <strong>el vidrio y cristal instalado y recibido de conformidad no cuenta con garantía contra roturas posteriores</strong> ni impactos térmicos o mecánicos.</p>
            </div>

            <!-- 6. Bloque de Firmas de Conformidad -->
            <div class="grid grid-cols-2 gap-12 mt-12 pt-4 text-center text-xs">
                <div>
                    <div class="border-t border-slate-400 pt-2 mx-6">
                        <p class="font-bold text-slate-800 m-0">Autorización y Conformidad del Cliente</p>
                        <p class="text-[10px] text-slate-500 m-0">{cot.cliente_nombre} (Acepto medidas y condiciones)</p>
                    </div>
                </div>
                <div>
                    <div class="border-t border-slate-400 pt-2 mx-6">
                        <p class="font-bold text-slate-800 m-0">Por {empresa.nombre_taller}</p>
                        <p class="text-[10px] text-slate-500 m-0">Responsable de Cotización y Control</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>