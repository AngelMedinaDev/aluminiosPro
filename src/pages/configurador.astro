---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

const { data } = await supabase
    .from('configuracion_precios')
    .select('*')
    .eq('id', 1)
    .single();

const cfg = data || {
    riel: 50, jamba: 50, zoclo: 50, cerco_fijo: 50, traslape: 50,
    cerco_chapa: 50, mosquitero: 50, vidrio: 50, herrajes: 5, factor: 2.5
};
---

<Layout title="Configurador de Precios | Aluminios Pro">
    <div class="min-h-screen bg-slate-100 text-slate-800 font-sans">
        <header class="bg-blue-600 text-white shadow-md p-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold tracking-tight m-0 text-white">Aluminios Pro</h1>
            <nav class="flex gap-6 items-center">
                <a href="/" class="text-blue-100 hover:text-white font-medium no-underline transition-colors">Cotizar</a>
                <a href="/seguimiento" class="text-blue-100 hover:text-white font-medium no-underline transition-colors">Seguimiento</a>
                <a href="/configurador" class="text-white font-bold no-underline border-b-2 border-white pb-0.5" title="Configurar Precios">
                    Configurador
                </a>
				<form action="/api/logout" method="POST"><button type="submit">Salir</button></form>
            </nav>
        </header>

        <main class="max-w-2xl mx-auto p-4 mt-6">
            <div class="bg-white rounded-xl shadow-lg p-6 border-t-4 border-blue-600">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-slate-800 m-0">Precios Base de Materiales</h2>
                    <p class="text-sm text-slate-500 mt-1">Estos costos alimentan directamente las fórmulas del servidor al cotizar.</p>
                </div>

                <form id="form-config" class="space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Riel ($ por tramo 6.1m)</label>
                            <input type="number" step="0.01" id="riel" value={cfg.riel} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Jamba ($ por tramo 6.1m)</label>
                            <input type="number" step="0.01" id="jamba" value={cfg.jamba} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Zoclo ($ por tramo 6.0m)</label>
                            <input type="number" step="0.01" id="zoclo" value={cfg.zoclo} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Cerco Fijo ($ por tramo 6.1m)</label>
                            <input type="number" step="0.01" id="cerco_fijo" value={cfg.cerco_fijo} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Traslape ($ por tramo 6.1m)</label>
                            <input type="number" step="0.01" id="traslape" value={cfg.traslape} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Cerco Chapa ($ por tramo 6.1m)</label>
                            <input type="number" step="0.01" id="cerco_chapa" value={cfg.cerco_chapa} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Mosquitero ($ base)</label>
                            <input type="number" step="0.01" id="mosquitero" value={cfg.mosquitero} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Vidrio ($ hoja 4.68 m²)</label>
                            <input type="number" step="0.01" id="vidrio" value={cfg.vidrio} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Herrajes ($ fijo por pieza)</label>
                            <input type="number" step="0.01" id="herrajes" value={cfg.herrajes} class="w-full p-2.5 border border-slate-300 rounded-lg bg-slate-50 font-semibold" required />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-amber-700 mb-1">Factor de Ganancia Default</label>
                            <input type="number" step="0.1" id="factor" value={cfg.factor} class="w-full p-2.5 border border-amber-400 rounded-lg bg-amber-50 font-bold text-amber-900" required />
                        </div>
                    </div>

                    <button type="submit" id="btn-save-cfg" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-4 rounded-xl text-base shadow cursor-pointer transition-colors">
                        Guardar Precios en Base de Datos
                    </button>
                </form>
            </div>
        </main>
    </div>
</Layout>

<script is:inline>
    const form = document.getElementById('form-config');
    const btn = document.getElementById('btn-save-cfg');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.innerText = 'Guardando precios...';

        const payload = {
            riel: document.getElementById('riel').value,
            jamba: document.getElementById('jamba').value,
            zoclo: document.getElementById('zoclo').value,
            cerco_fijo: document.getElementById('cerco_fijo').value,
            traslape: document.getElementById('traslape').value,
            cerco_chapa: document.getElementById('cerco_chapa').value,
            mosquitero: document.getElementById('mosquitero').value,
            vidrio: document.getElementById('vidrio').value,
            herrajes: document.getElementById('herrajes').value,
            factor: document.getElementById('factor').value
        };

        try {
            const res = await fetch('/api/configuracion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                btn.innerText = '✅ ¡Precios Actualizados!';
                setTimeout(() => { btn.innerText = 'Guardar Precios en Base de Datos'; }, 2000);
            } else {
                alert('Error al guardar: ' + data.message);
                btn.innerText = 'Guardar Precios en Base de Datos';
            }
        } catch (err) {
            alert('Error de conexión con el servidor.');
            btn.innerText = 'Guardar Precios en Base de Datos';
        } finally {
            btn.disabled = false;
        }
    });
</script>