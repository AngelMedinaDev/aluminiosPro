---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

const { data: cotizaciones, error } = await supabase
    .from('cotizaciones')
    .select('*')
    .order('created_at', { ascending: false });

const lista = cotizaciones || [];

const obtenerEstatus = (c: any) => c.estatus || c.detalles_json?.estatus || 'Pendiente';

const totalProspectos = lista.length;
const totalVendido = lista
    .filter((c: any) => obtenerEstatus(c) === 'Vendido')
    .reduce((acc: number, c: any) => acc + (Number(c.total) || 0), 0);
const totalEnSeguimiento = lista
    .filter((c: any) => obtenerEstatus(c) === 'Pendiente')
    .reduce((acc: number, c: any) => acc + (Number(c.total) || 0), 0);

function obtenerNombreTipo(tipo: any) {
    if (tipo === 'v2') return 'Ventana 2"';
    if (tipo === 'pta3') return 'Puerta 3"';
    return tipo || 'Trabajo';
}
---

<Layout title="Seguimiento de Clientes | Aluminios Pro">
    <div class="min-h-screen bg-slate-100 text-slate-800 font-sans">
        <header class="bg-blue-600 text-white shadow-md p-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold tracking-tight m-0 text-white">Aluminios Pro</h1>
            <nav class="flex gap-6 items-center">
                <a href="/" class="text-blue-100 hover:text-white font-medium no-underline transition-colors">Cotizar</a>
                <a href="/seguimiento" class="text-white font-bold no-underline border-b-2 border-white pb-0.5">Seguimiento</a>
                <a href="/configurador" class="text-blue-100 hover:text-white transition-colors" title="Configurar Precios">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </a>
            </nav>
        </header>

        <main class="max-w-5xl mx-auto p-4 mt-6 space-y-6">
            <!-- Tarjetas de Resumen Dinámicas (Se actualizan al filtrar) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white p-5 rounded-xl shadow border-l-4 border-blue-600">
                    <p class="text-xs font-bold uppercase text-slate-400 m-0">Prospectos Mostrados</p>
                    <p id="kpi-prospectos" class="text-3xl font-black text-slate-800 mt-1 mb-0">{totalProspectos}</p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow border-l-4 border-amber-500">
                    <p class="text-xs font-bold uppercase text-slate-400 m-0">En Seguimiento (Pendientes)</p>
                    <p id="kpi-pendientes" class="text-3xl font-black text-amber-600 mt-1 mb-0">
                        ${totalEnSeguimiento.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow border-l-4 border-green-600">
                    <p class="text-xs font-bold uppercase text-slate-400 m-0">Total Cerrado (Vendidos)</p>
                    <p id="kpi-vendidos" class="text-3xl font-black text-green-600 mt-1 mb-0">
                        ${totalVendido.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </p>
                </div>
            </div>

            <!-- Contenedor Principal del Historial -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden border-t-4 border-blue-600">
                <!-- Barra de Filtros Avanzados y Exportación -->
                <div class="p-5 border-b border-slate-200 space-y-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800 m-0">Historial y Filtros de Prospectos</h2>
                            <p class="text-sm text-slate-500 m-0">Filtra por estatus, fechas de venta o acomoda por monto</p>
                        </div>
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <button id="btn-limpiar-filtros" type="button" class="text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-lg cursor-pointer border-0 transition-colors">
                                Limpiar filtros
                            </button>
                            <button id="btn-exportar-excel" type="button" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-4 py-2 rounded-lg cursor-pointer border-0 shadow transition-colors">
                                📊 Exportar a Excel
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 pt-2">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Buscar Cliente / Tel</label>
                            <input type="text" id="filtro-busqueda" placeholder="Ej. Angel o 8122..." class="w-full p-2 border border-slate-300 rounded-lg text-sm bg-slate-50" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Estatus</label>
                            <select id="filtro-estatus" class="w-full p-2 border border-slate-300 rounded-lg text-sm font-medium bg-slate-50">
                                <option value="Todos">Todos los estatus</option>
                                <option value="Pendiente">⏳ Solo Pendientes</option>
                                <option value="Vendido">✅ Solo Vendidos</option>
                                <option value="Descartado">❌ Descartados</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Desde Fecha</label>
                            <input type="date" id="filtro-desde" class="w-full p-2 border border-slate-300 rounded-lg text-sm bg-slate-50" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Hasta Fecha</label>
                            <input type="date" id="filtro-hasta" class="w-full p-2 border border-slate-300 rounded-lg text-sm bg-slate-50" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 mb-1">Ordenar por</label>
                            <select id="filtro-orden" class="w-full p-2 border border-slate-300 rounded-lg text-sm font-medium bg-slate-50">
                                <option value="recientes">Más recientes primero</option>
                                <option value="antiguos">Más antiguos primero</option>
                                <option value="mayor">Mayor precio primero</option>
                                <option value="menor">Menor precio primero</option>
                            </select>
                        </div>
                    </div>
                </div>

                {error && (
                    <div class="p-4 bg-red-50 text-red-700 text-sm">
                        Error al cargar cotizaciones: {error.message}
                    </div>
                )}

                <!-- VISTA MÓVIL (Tarjetas apiladas para celular) -->
                <div id="contenedor-movil" class="block sm:hidden divide-y divide-slate-200">
                    {lista.length === 0 ? (
                        <div class="p-8 text-center text-slate-400">
                            Aún no hay prospectos guardados.
                        </div>
                    ) : (
                        lista.map((item: any) => {
                            const det = item.detalles_json || {};
                            const estatus = obtenerEstatus(item);
                            const tel = item.cliente_telefono || det.telefono || '';
                            const nombreTrabajo = obtenerNombreTipo(det.tipo);
                            const fechaObj = new Date(item.created_at);
                            const fechaISO = fechaObj.toISOString().split('T')[0];
                            const timestamp = fechaObj.getTime();
                            const monto = Number(item.total) || 0;
                            const fecha = fechaObj.toLocaleDateString('es-MX', {
                                day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                            });
                            const totalFmt = '$' + monto.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            const msgSeguimiento = `¡Hola ${item.cliente_nombre}! Te escribo de Aluminios Pro para saber si tuviste oportunidad de revisar la cotización de tu ${nombreTrabajo} (${totalFmt}). ¿Tienes alguna duda?`;

                            return (
                                <div
                                    class="p-4 space-y-3 bg-white item-prospecto-movil"
                                    data-estatus={estatus}
                                    data-fecha={fechaISO}
                                    data-timestamp={timestamp}
                                    data-total={monto}
                                    data-busqueda={`${item.cliente_nombre || ''} ${tel}`.toLowerCase()}
                                >
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="font-bold text-slate-900 text-base m-0">{item.cliente_nombre}</p>
                                            <p class="text-xs text-slate-500 m-0">+52 {tel} • {fecha}</p>
                                        </div>
                                        <span class="font-black text-green-600 text-lg">{totalFmt}</span>
                                    </div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg text-xs text-slate-700">
                                        <p class="font-semibold m-0">{det.cantidad || 1}x {nombreTrabajo} ({det.largo || 0}m x {det.alto || 0}m)</p>
                                        {det.costo_real && <p class="text-slate-400 m-0 mt-0.5">Costo base: ${Number(det.costo_real).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</p>}
                                    </div>
                                    <div class="flex justify-between items-center pt-2 gap-2">
                                        <select
                                            class="select-estatus p-2 rounded-lg border text-xs font-bold bg-white w-1/2 cursor-pointer"
                                            data-id={item.id}
                                            data-detalles={JSON.stringify(det)}
                                        >
                                            <option value="Pendiente" selected={estatus === 'Pendiente'}>⏳ Pendiente</option>
                                            <option value="Vendido" selected={estatus === 'Vendido'}>✅ Vendido</option>
                                            <option value="Descartado" selected={estatus === 'Descartado'}>❌ Descartado</option>
                                        </select>
                                        {tel && (
                                            <a
                                                href={`https://wa.me/52${tel}?text=${encodeURIComponent(msgSeguimiento)}`}
                                                target="_blank"
                                                class="flex-1 text-center bg-green-500 hover:bg-green-600 text-white text-xs font-bold py-2.5 px-3 rounded-lg no-underline shadow"
                                            >
                                                📲 Dar Seguimiento
                                            </a>
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    )}
                </div>

                <!-- VISTA ESCRITORIO (Tabla limpia para pantallas medianas y grandes) -->
                <div class="hidden sm:block overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="p-4">Fecha</th>
                                <th class="p-4">Cliente / WhatsApp</th>
                                <th class="p-4">Trabajo y Medidas</th>
                                <th class="p-4">Total Cotizado</th>
                                <th class="p-4">Estatus</th>
                                <th class="p-4 text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="contenedor-tabla" class="divide-y divide-slate-200 text-sm">
                            {lista.length === 0 ? (
                                <tr>
                                    <td colspan="6" class="p-8 text-center text-slate-400">
                                        Aún no hay prospectos guardados. Envía una cotización por WhatsApp para verla aquí.
                                    </td>
                                </tr>
                            ) : (
                                lista.map((item: any) => {
                                    const det = item.detalles_json || {};
                                    const estatus = obtenerEstatus(item);
                                    const tel = item.cliente_telefono || det.telefono || '';
                                    const nombreTrabajo = obtenerNombreTipo(det.tipo);
                                    const fechaObj = new Date(item.created_at);
                                    const fechaISO = fechaObj.toISOString().split('T')[0];
                                    const timestamp = fechaObj.getTime();
                                    const monto = Number(item.total) || 0;
                                    const costoReal = Number(det.costo_real) || 0;
                                    const fecha = fechaObj.toLocaleDateString('es-MX', {
                                        day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                                    });
                                    const descTrabajo = `${det.cantidad || 1}x ${nombreTrabajo} (${det.largo || 0}m x ${det.alto || 0}m)`;
                                    const totalFmt = '$' + monto.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                    const msgSeguimiento = `¡Hola ${item.cliente_nombre}! Te escribo de Aluminios Pro para saber si tuviste oportunidad de revisar la cotización de tu ${nombreTrabajo} (${totalFmt}). ¿Tienes alguna duda?`;

                                    return (
                                        <tr
                                            class="hover:bg-slate-50 item-prospecto-tabla"
                                            data-estatus={estatus}
                                            data-fecha={fechaISO}
                                            data-timestamp={timestamp}
                                            data-total={monto}
                                            data-costo={costoReal}
                                            data-cliente={item.cliente_nombre || ''}
                                            data-telefono={tel}
                                            data-trabajo={nombreTrabajo}
                                            data-cantidad={det.cantidad || 1}
                                            data-medidas={`${det.largo || 0}m x ${det.alto || 0}m`}
                                            data-busqueda={`${item.cliente_nombre || ''} ${tel}`.toLowerCase()}
                                        >
                                            <td class="p-4 text-slate-500 whitespace-nowrap">{fecha}</td>
                                            <td class="p-4">
                                                <p class="font-bold text-slate-800 m-0">{item.cliente_nombre}</p>
                                                <p class="text-xs text-slate-500 m-0">+52 {tel}</p>
                                            </td>
                                            <td class="p-4">
                                                <p class="font-medium text-slate-700 m-0">{descTrabajo}</p>
                                                {det.costo_real && (
                                                    <p class="text-xs text-slate-400 m-0">
                                                        Costo base: ${costoReal.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                                                    </p>
                                                )}
                                            </td>
                                            <td class="p-4 font-black text-green-600 text-base whitespace-nowrap">
                                                {totalFmt}
                                            </td>
                                            <td class="p-4">
                                                <select
                                                    class="select-estatus p-1.5 rounded-lg border text-xs font-bold cursor-pointer"
                                                    data-id={item.id}
                                                    data-detalles={JSON.stringify(det)}
                                                >
                                                    <option value="Pendiente" selected={estatus === 'Pendiente'}>⏳ Pendiente</option>
                                                    <option value="Vendido" selected={estatus === 'Vendido'}>✅ Vendido</option>
                                                    <option value="Descartado" selected={estatus === 'Descartado'}>❌ Descartado</option>
                                                </select>
                                            </td>
                                            <td class="p-4 text-center">
                                                {tel && (
                                                    <a
                                                        href={`https://wa.me/52${tel}?text=${encodeURIComponent(msgSeguimiento)}`}
                                                        target="_blank"
                                                        class="inline-flex items-center gap-1 bg-green-500 hover:bg-green-600 text-white text-xs font-bold px-3 py-2 rounded-lg no-underline transition-colors shadow"
                                                    >
                                                        Dar Seguimiento
                                                    </a>
                                                )}
                                            </td>
                                        </tr>
                                    );
                                })
                            )}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</Layout>

<script is:inline>
    const inputBusqueda = document.getElementById('filtro-busqueda');
    const selectEstatus = document.getElementById('filtro-estatus');
    const inputDesde = document.getElementById('filtro-desde');
    const inputHasta = document.getElementById('filtro-hasta');
    const selectOrden = document.getElementById('filtro-orden');
    const btnLimpiar = document.getElementById('btn-limpiar-filtros');
    const btnExportar = document.getElementById('btn-exportar-excel');

    function aplicarFiltrosYOrden() {
        const texto = (inputBusqueda?.value || '').toLowerCase().trim();
        const estatus = selectEstatus?.value || 'Todos';
        const desde = inputDesde?.value || '';
        const hasta = inputHasta?.value || '';
        const orden = selectOrden?.value || 'recientes';

        const filasTabla = Array.from(document.querySelectorAll('.item-prospecto-tabla'));
        const tarjetasMovil = Array.from(document.querySelectorAll('.item-prospecto-movil'));

        const evaluarItem = (el) => {
            const matchTexto = !texto || (el.dataset.busqueda || '').includes(texto);
            const matchEstatus = estatus === 'Todos' || el.dataset.estatus === estatus;
            const fechaItem = el.dataset.fecha || '';
            const matchDesde = !desde || fechaItem >= desde;
            const matchHasta = !hasta || fechaItem <= hasta;
            return matchTexto && matchEstatus && matchDesde && matchHasta;
        };

        const compararItems = (a, b) => {
            if (orden === 'recientes') return Number(b.dataset.timestamp) - Number(a.dataset.timestamp);
            if (orden === 'antiguos') return Number(a.dataset.timestamp) - Number(b.dataset.timestamp);
            if (orden === 'mayor') return Number(b.dataset.total) - Number(a.dataset.total);
            if (orden === 'menor') return Number(a.dataset.total) - Number(b.dataset.total);
            return 0;
        };

        let conteoVisibles = 0;
        let sumaPendientes = 0;
        let sumaVendidos = 0;

        filasTabla.sort(compararItems);
        tarjetasMovil.sort(compararItems);

        const tbody = document.getElementById('contenedor-tabla');
        const divMovil = document.getElementById('contenedor-movil');

        filasTabla.forEach(fila => {
            const visible = evaluarItem(fila);
            fila.style.display = visible ? '' : 'none';
            if (tbody) tbody.appendChild(fila);

            if (visible) {
                conteoVisibles++;
                const monto = Number(fila.dataset.total) || 0;
                if (fila.dataset.estatus === 'Pendiente') sumaPendientes += monto;
                if (fila.dataset.estatus === 'Vendido') sumaVendidos += monto;
            }
        });

        tarjetasMovil.forEach(card => {
            const visible = evaluarItem(card);
            card.style.display = visible ? '' : 'none';
            if (divMovil) divMovil.appendChild(card);
        });

        const fmt = (n) => '$' + n.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('kpi-prospectos').innerText = conteoVisibles;
        document.getElementById('kpi-pendientes').innerText = fmt(sumaPendientes);
        document.getElementById('kpi-vendidos').innerText = fmt(sumaVendidos);
    }

    [inputBusqueda, selectEstatus, inputDesde, inputHasta, selectOrden].forEach(el => {
        if (el) el.addEventListener('input', aplicarFiltrosYOrden);
        if (el) el.addEventListener('change', aplicarFiltrosYOrden);
    });

    if (btnLimpiar) {
        btnLimpiar.addEventListener('click', () => {
            if (inputBusqueda) inputBusqueda.value = '';
            if (selectEstatus) selectEstatus.value = 'Todos';
            if (inputDesde) inputDesde.value = '';
            if (inputHasta) inputHasta.value = '';
            if (selectOrden) selectOrden.value = 'recientes';
            aplicarFiltrosYOrden();
        });
    }

    // Exportar los registros filtrados actualmente a Excel (.csv con UTF-8 BOM)
    if (btnExportar) {
        btnExportar.addEventListener('click', () => {
            const filasVisibles = Array.from(document.querySelectorAll('.item-prospecto-tabla'))
                .filter(fila => fila.style.display !== 'none');

            if (filasVisibles.length === 0) {
                alert('No hay registros visibles con los filtros actuales para exportar.');
                return;
            }

            const encabezados = [
                'Fecha',
                'Cliente',
                'WhatsApp',
                'Trabajo',
                'Cantidad',
                'Medidas',
                'Costo Base (MXN)',
                'Precio Venta (MXN)',
                'Ganancia Estimada (MXN)',
                'Estatus'
            ];

            const escaparCSV = (texto) => `"${String(texto ?? '').replace(/"/g, '""')}"`;

            const lineas = filasVisibles.map(fila => {
                const costo = Number(fila.dataset.costo) || 0;
                const venta = Number(fila.dataset.total) || 0;
                const ganancia = venta - costo;

                return [
                    escaparCSV(fila.dataset.fecha),
                    escaparCSV(fila.dataset.cliente),
                    escaparCSV('+52 ' + (fila.dataset.telefono || '')),
                    escaparCSV(fila.dataset.trabajo),
                    escaparCSV(fila.dataset.cantidad),
                    escaparCSV(fila.dataset.medidas),
                    costo.toFixed(2),
                    venta.toFixed(2),
                    ganancia.toFixed(2),
                    escaparCSV(fila.dataset.estatus)
                ].join(',');
            });

            // El carácter \uFEFF (BOM) hace que Excel en Windows abra acentos y columnas automáticamente
            const contenidoCSV = '\uFEFF' + [encabezados.join(','), ...lineas].join('\r\n');
            const blob = new Blob([contenidoCSV], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);

            const link = document.createElement('a');
            const hoy = new Date().toISOString().split('T')[0];
            link.href = url;
            link.setAttribute('download', `Reporte_AluminiosPro_${hoy}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        });
    }

    document.querySelectorAll('.select-estatus').forEach(select => {
        select.addEventListener('change', async (e) => {
            const el = e.target;
            const id = el.dataset.id;
            const detallesActuales = JSON.parse(el.dataset.detalles || '{}');
            const nuevoEstatus = el.value;

            el.disabled = true;
            try {
                const res = await fetch('/api/seguimiento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: Number(id),
                        estatusActual: nuevoEstatus,
                        detallesActuales
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('No se pudo actualizar el estatus: ' + data.message);
                }
            } catch (err) {
                alert('Error de conexión al actualizar estatus.');
            } finally {
                el.disabled = false;
            }
        });
    });
</script>