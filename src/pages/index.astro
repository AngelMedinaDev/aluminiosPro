---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cotizador de Aluminio">
    <div class="min-h-screen bg-slate-100 text-slate-800 font-sans">
        <header class="bg-blue-600 text-white shadow-md p-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold tracking-tight m-0 text-white">Aluminios Pro</h1>
            <nav class="flex gap-5 items-center">
                <a href="/" class="text-white font-bold no-underline border-b-2 border-white pb-0.5">Cotizar</a>
                <a href="/seguimiento" class="text-blue-100 hover:text-white font-medium no-underline transition-colors">Seguimiento</a>
                <a href="/configurador" class="text-blue-100 hover:text-white transition-colors" title="Configurar Precios">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </a>
                <form action="/api/logout" method="POST" class="m-0">
                    <button type="submit" class="bg-blue-700 hover:bg-red-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg border-0 cursor-pointer transition-colors">
                        Salir
                    </button>
                </form>
            </nav>
        </header>

        <main class="max-w-xl mx-auto p-4 mt-6">
            <div class="bg-white rounded-xl shadow-lg p-6 border-t-4 border-blue-600">
                <h2 class="text-2xl font-bold mb-6 text-gray-800">Nueva Cotización</h2>
                
                <form id="cotizador-form" class="space-y-5" onsubmit="return false;">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Tipo de Trabajo</label>
                            <select id="tipo" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-800">
                                <option value="v2">Ventana 2"</option>
                                <option value="pta3">Puerta 3"</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Cantidad (Piezas)</label>
                            <input type="number" id="cantidad" value="1" min="1" class="w-full p-3 border border-gray-300 rounded-lg text-lg text-center text-gray-800" required>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Largo (m)</label>
                            <input type="number" id="largo" step="0.01" value="1.50" class="w-full p-3 border border-gray-300 rounded-lg text-lg text-center text-gray-800" required>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Alto (m)</label>
                            <input type="number" id="alto" step="0.01" value="1.50" class="w-full p-3 border border-gray-300 rounded-lg text-lg text-center text-gray-800" required>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Factor de Ganancia</label>
                        <input type="number" id="factor-override" step="0.1" value="2.5" class="w-full p-3 border border-gray-300 rounded-lg bg-yellow-50 text-center font-bold text-gray-800">
                    </div>

                    <!-- Cuadro de Precio de la Pieza Actual -->
                    <div class="mt-4 bg-slate-800 rounded-xl p-5 text-center shadow-inner">
                        <p class="text-slate-300 text-xs font-semibold uppercase tracking-wider mb-1">
                            Subtotal pieza actual (<span id="res-cant">1</span> pza)
                        </p>
                        <p class="text-4xl font-black text-green-400 m-0" id="precio-final">$0.00</p>
                        <p class="text-xs text-slate-400 mt-2 cursor-pointer hover:text-slate-200 transition-colors" id="toggle-costo">
                            Costo base: <span id="costo-real" class="blur-sm select-none">$0.00</span> (clic para ver)
                        </p>

                        <button type="button" id="btn-agregar-partida" class="mt-4 w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 px-4 rounded-lg text-sm shadow transition-colors cursor-pointer border-0">
                            + Agregar esta pieza a la lista del cliente
                        </button>
                    </div>

                    <!-- CARRITO DE PARTIDAS -->
                    <div id="carrito-container" class="hidden border-2 border-blue-100 bg-blue-50/40 rounded-xl p-4 space-y-3">
                        <div class="flex justify-between items-center">
                            <h3 class="text-sm font-bold text-slate-800 m-0 uppercase tracking-wide">
                                Partidas en esta cotización (<span id="carrito-count">0</span>)
                            </h3>
                            <button type="button" id="btn-vaciar-carrito" class="text-xs text-red-600 hover:underline bg-transparent border-0 cursor-pointer font-semibold">
                                Vaciar lista
                            </button>
                        </div>

                        <div id="carrito-lista" class="divide-y divide-slate-200 text-sm bg-white rounded-lg border border-slate-200 overflow-hidden"></div>

                        <div class="flex justify-between items-center pt-2 border-t border-slate-200">
                            <span class="text-sm font-bold text-slate-700">GRAN TOTAL CLIENTE:</span>
                            <span id="carrito-gran-total" class="text-2xl font-black text-blue-700">$0.00</span>
                        </div>
                    </div>

                    <!-- SECCIÓN DE SEGUIMIENTO REAL -->
                    <div class="pt-4 border-t border-gray-200 space-y-4">
                        <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider m-0">
                            Datos del prospecto (Se guarda al enviar WhatsApp)
                        </p>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">Nombre del Cliente</label>
                            <input type="text" id="cliente" placeholder="Ej. Juan Pérez" class="w-full p-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-800">
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">WhatsApp del Cliente (10 dígitos)</label>
                            <div class="flex gap-0">
                                <span class="inline-flex items-center px-3 text-sm text-gray-900 bg-gray-200 border border-r-0 border-gray-300 rounded-l-lg font-bold">+52</span>
                                <input type="tel" id="telefono" maxlength="10" placeholder="8112345678" class="rounded-none rounded-r-lg bg-gray-50 border border-gray-300 text-gray-900 focus:ring-green-500 focus:border-green-500 block flex-1 min-w-0 w-full text-lg p-2.5">
                            </div>
                        </div>
                    </div>

                    <button type="button" id="btn-whatsapp" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-4 rounded-xl text-lg shadow-lg flex items-center justify-center gap-2 border-0 cursor-pointer transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.898-4.45 9.896-9.892-.002-5.446-4.452-9.892-9.893-9.892-5.452 0-9.897 4.446-9.897 9.896 0 1.964.55 3.905 1.595 5.568l-1.096 4.004 4.093-1.076zm-1.127-10.963c-.156-.347-.323-.353-.464-.359-.133-.005-.286-.005-.443-.005-.156 0-.411.059-.625.292-.213.233-.812.793-.812 1.933 0 1.14.832 2.244.949 2.399.117.155 1.63 2.492 3.946 3.487 1.348.577 1.942.748 2.684.717.593-.024 1.815-.742 2.072-1.46.257-.718.257-1.332.18-1.46-.077-.128-.286-.205-.599-.362-.313-.157-1.849-.914-2.135-1.018-.286-.104-.495-.157-.704.157-.209.313-.807 1.018-.988 1.228-.182.209-.364.233-.677.076-.313-.157-1.32-.487-2.515-1.554-.928-.827-1.553-1.85-1.735-2.164-.182-.313-.02-.482.137-.639.141-.14.313-.365.469-.548.156-.183.208-.313.313-.522.104-.209.052-.391-.026-.548-.078-.157-.704-1.697-.964-2.322z"/></svg>
                        <span id="btn-wa-text">Enviar WhatsApp y Guardar Prospecto</span>
                    </button>
                </form>
            </div>
        </main>
    </div>
</Layout>

<script is:inline>
    const toggleBtn = document.getElementById('toggle-costo');
    const btnWa = document.getElementById('btn-whatsapp');
    const btnWaText = document.getElementById('btn-wa-text');
    const btnAgregarPartida = document.getElementById('btn-agregar-partida');
    const btnVaciarCarrito = document.getElementById('btn-vaciar-carrito');

    let ultimoPrecioCalculado = 0;
    let ultimoCostoCalculado = 0;
    let partidasCarrito = [];

    const fmtMXN = (n) => '$' + (Number(n) || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    function obtenerDatosActuales(guardarEnBD = false) {
        const telLimpio = (document.getElementById('telefono').value || '').replace(/\D/g, '');
        const tipoSelect = document.getElementById('tipo');
        const tipoNombre = tipoSelect ? tipoSelect.options[tipoSelect.selectedIndex].text : '';

        return {
            cliente: document.getElementById('cliente').value.trim(),
            telefono: telLimpio,
            tipo: document.getElementById('tipo').value,
            tipoNombre: tipoNombre,
            cantidad: parseInt(document.getElementById('cantidad').value) || 1,
            largo: parseFloat(document.getElementById('largo').value) || 0,
            alto: parseFloat(document.getElementById('alto').value) || 0,
            factor: parseFloat(document.getElementById('factor-override').value) || 2.5,
            partidas: partidasCarrito,
            guardar: guardarEnBD
        };
    }

    // Recibe validarSesion = true cuando el usuario mueve un input en vivo
    async function calcularEnVivo(validarSesion = false) {
        const data = obtenerDatosActuales(false);
        document.getElementById('res-cant').innerText = data.cantidad;

        try {
            const response = await fetch('/api/cotizar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(data)
            });

            if (validarSesion && response.status === 401) {
                window.location.replace('/login?motivo=otro_dispositivo');
                return;
            }

            const result = await response.json();

            if (result.success) {
                ultimoPrecioCalculado = result.precioVenta;
                ultimoCostoCalculado = result.costoReal;
                document.getElementById('precio-final').innerText = fmtMXN(result.precioVenta);
                document.getElementById('costo-real').innerText = fmtMXN(result.costoReal);
            }
        } catch (err) {
            console.error('Error al calcular:', err);
        }
    }

    function renderizarCarrito() {
        const container = document.getElementById('carrito-container');
        const listaEl = document.getElementById('carrito-lista');
        const countEl = document.getElementById('carrito-count');
        const granTotalEl = document.getElementById('carrito-gran-total');

        if (partidasCarrito.length === 0) {
            container.classList.add('hidden');
            return;
        }

        container.classList.remove('hidden');
        countEl.innerText = partidasCarrito.length;

        let sumaTotal = 0;
        listaEl.innerHTML = '';

        partidasCarrito.forEach((item, index) => {
            sumaTotal += item.subtotal;
            const fila = document.createElement('div');
            fila.className = 'p-3 flex justify-between items-center hover:bg-slate-50';
            fila.innerHTML = `
                <div>
                    <p class="font-bold text-slate-800 m-0">${item.cantidad}x ${item.tipoNombre}</p>
                    <p class="text-xs text-slate-500 m-0">Medidas: ${item.largo}m x ${item.alto}m</p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="font-bold text-green-600">${fmtMXN(item.subtotal)}</span>
                    <button type="button" data-idx="${index}" class="btn-quitar-item text-xs bg-red-50 text-red-600 hover:bg-red-100 font-bold px-2 py-1 rounded border-0 cursor-pointer">
                        ✕
                    </button>
                </div>
            `;
            listaEl.appendChild(fila);
        });

        granTotalEl.innerText = fmtMXN(sumaTotal);

        document.querySelectorAll('.btn-quitar-item').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const idx = parseInt(e.currentTarget.dataset.idx);
                partidasCarrito.splice(idx, 1);
                renderizarCarrito();
            });
        });
    }

    if (btnAgregarPartida) {
        btnAgregarPartida.addEventListener('click', async () => {
            await calcularEnVivo(true);
            const actual = obtenerDatosActuales(false);
            if (actual.largo <= 0 || actual.alto <= 0) {
                alert('Pon medidas válidas mayores a 0 para agregar la pieza.');
                return;
            }
            partidasCarrito.push({
                tipo: actual.tipo,
                tipoNombre: actual.tipoNombre,
                cantidad: actual.cantidad,
                largo: actual.largo,
                alto: actual.alto,
                factor: actual.factor,
                costo: ultimoCostoCalculado,
                subtotal: ultimoPrecioCalculado
            });
            renderizarCarrito();
        });
    }

    if (btnVaciarCarrito) {
        btnVaciarCarrito.addEventListener('click', () => {
            partidasCarrito = [];
            renderizarCarrito();
        });
    }

    // Cuando el usuario mueve cualquier input, sí validamos si su sesión sigue siendo la única activa
    ['tipo', 'cantidad', 'largo', 'alto', 'factor-override'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', () => calcularEnVivo(true));
    });

    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            const costoReal = document.getElementById('costo-real');
            if (costoReal) costoReal.classList.toggle('blur-sm');
        });
    }

    if (btnWa) {
        btnWa.addEventListener('click', async () => {
            const data = obtenerDatosActuales(true);

            if (!data.cliente) {
                alert('Compadre, ponle el nombre del cliente para poder darle seguimiento.');
                document.getElementById('cliente').focus();
                return;
            }

            if (data.telefono.length < 10) {
                alert('Compadre, pon un número de WhatsApp válido de 10 dígitos.');
                document.getElementById('telefono').focus();
                return;
            }

            btnWa.disabled = true;
            btnWaText.innerText = 'Guardando prospecto...';

            try {
                const response = await fetch('/api/cotizar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(data)
                });

                if (response.status === 401) {
                    window.location.replace('/login?motivo=otro_dispositivo');
                    return;
                }

                const result = await response.json();

                if (!result.success) {
                    alert('Aviso: No se pudo guardar en la base de datos (' + (result.message || 'Error') + '), pero te abriremos WhatsApp.');
                }

                const totalFinalFmt = fmtMXN(result.precioVenta);

                let desgloseLineas = '';
                if (partidasCarrito.length > 0) {
                    desgloseLineas = partidasCarrito.map((p, i) =>
                        `${i + 1}. *${p.cantidad}x ${p.tipoNombre}* (${p.largo}m x ${p.alto}m) - ${fmtMXN(p.subtotal)}`
                    ).join('\n');
                } else {
                    desgloseLineas = `• *${data.cantidad}x ${data.tipoNombre}* (${data.largo}m x ${data.alto}m) - ${totalFinalFmt}`;
                }

                const mensaje = `¡Hola ${data.cliente}! Aquí tienes la cotización de tu proyecto en Aluminios Pro:\n\n${desgloseLineas}\n\n*Total Estimado:* ${totalFinalFmt}\n\nQuedamos a tus órdenes para cualquier duda.`;
                window.open(`https://wa.me/52${data.telefono}?text=${encodeURIComponent(mensaje)}`, '_blank');

                partidasCarrito = [];
                renderizarCarrito();

            } catch (err) {
                alert('Error de conexión con el servidor.');
            } finally {
                btnWa.disabled = false;
                btnWaText.innerText = 'Enviar WhatsApp y Guardar Prospecto';
            }
        });
    }

    // Al cargar por primera vez solo calcula sin patear en falso
    window.addEventListener('DOMContentLoaded', () => calcularEnVivo(false));
</script>